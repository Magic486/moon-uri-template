///|
test "conformance negative-tests.json #118" {
  let variables : Map[String, UriValue] = {
    "id": Scalar("thing"),
    "var": Scalar("value"),
    "hello": Scalar("Hello World!"),
    "with space": Scalar("fail"),
    " leading_space": Scalar("Hi!"),
    "trailing_space ": Scalar("Bye!"),
    "empty": Scalar(""),
    "path": Scalar("/foo/bar"),
    "x": Scalar("1024"),
    "y": Scalar("768"),
    "list": List(["red", "green", "blue"]),
    "keys": Assoc([("semi", ";"), ("dot", "."), ("comma", ",")]),
    "example": Scalar("red"),
    "searchTerms": Scalar("uri templates"),
    "~thing": Scalar("some-user"),
    "default-graph-uri": List([
      "http://www.example/book/", "http://www.example/papers/",
    ]),
    "query": Scalar(
      "PREFIX dc: <http://purl.org/dc/elements/1.1/> SELECT ?book ?who WHERE { ?book dc:creator ?who }",
    ),
  }
  assert_true(conformance_rejects("{/id*", variables))
}

